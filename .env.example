# The Deposit War Room - Environment Variables
# Copy this file to .env.local and fill in your Supabase project keys

# Supabase Project URL (Found under Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (Found under Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: If these keys are not set, the application automatically uses its built-in
# local interactive storage so you can run the entire 5-minute demo immediately!
